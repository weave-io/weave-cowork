# Copy to deploy/.env (docker compose reads it next to the compose file) to turn on voice channels.
# Pick a key name and a long random secret (at least 32 characters), e.g. `openssl rand -hex 24`.
LIVEKIT_API_KEY=cowork
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
# Where browsers reach LiveKit. Leave empty to use the same host as the web app on port 7880.
# Behind a reverse proxy: wss://livekit.example.com
LIVEKIT_URL=
# false: LiveKit announces the machine's own addresses: right for one machine, a LAN or a test, and the quick start.
# true: it finds the public IP with STUN: turn it on for a server with a public IP that people reach over the internet.
LIVEKIT_USE_EXTERNAL_IP=false
