<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CoWork.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.*" />
    <EmbeddedResource Include="Migrations\*.sql" />
    <!-- brief 13: the font kit and the scheme script every shown page gets (PageKit.cs); the fonts' licences sit beside them -->
    <EmbeddedResource Include="PageKit\fonts\*.woff2;PageKit\fonts\fonts.css" LogicalName="CoWork.Server.PageKit.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="PageKit\scheme.js" LogicalName="CoWork.Server.PageKit.scheme.js" />
    <ProjectReference Include="..\CoWork.Contracts\CoWork.Contracts.csproj" />
  </ItemGroup>
</Project>
